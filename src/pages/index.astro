---
import home from '../data/home.json';
const habitaciones = Object.values(import.meta.glob('../data/habitaciones/*.md', { eager: true }));
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{home.titulo}</title>
    <style>
      body { font-family: system-ui, sans-serif; background:#F6F1EA; color:#14363F; max-width: 760px; margin: 0 auto; padding: 24px; }
      .aviso { background:#14363F; color:#F6F1EA; padding:8px 12px; font-size:14px; }
      img { max-width:100%; height:auto; }
      article { border-top:1px solid #7FA79B; padding:16px 0; }
    </style>
  </head>
  <body>
    <p class="aviso">PRUEBA INTERNA · contenido ficticio · no indexable</p>
    <h1>{home.titulo}</h1>
    <p>{home.subtitulo}</p>
    {home.imagen && <img src={home.imagen} alt="" />}
    <p>Teléfono: {home.telefono}</p>
    <h2>Habitaciones (ficticias)</h2>
    {habitaciones.map((h) => (
      <article>
        <h3>{h.frontmatter.titulo}</h3>
        <p><strong>{h.frontmatter.estado}</strong></p>
        {h.frontmatter.imagen && <img src={h.frontmatter.imagen} alt="" />}
        <h.Content />
      </article>
    ))}
    <h2>Preguntas frecuentes</h2>
    {home.faqs.map((f) => (<details><summary>{f.pregunta}</summary><p>{f.respuesta}</p></details>))}
  </body>
</html>
